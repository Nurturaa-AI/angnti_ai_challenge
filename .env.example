# Repo Archaeologist configuration.
#
# Copy this file to `.env` and fill in your key. `.env` is gitignored and must
# never be committed. No key is required for `--mock` runs.
#
#   cp .env.example .env

# Google Gemini API key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for analysis. See https://ai.google.dev/gemini-api/docs/pricing
# Known-priced options: gemini-3.7-flash, gemini-3.5-flash-lite, gemini-3.1-pro-preview
REPO_ARCHAEOLOGIST_MODEL=gemini-3.7-flash

# "gemini" for real API calls, "mock" for offline, deterministic, zero-cost runs.
REPO_ARCHAEOLOGIST_PROVIDER=gemini

# Sampling seed. The Interactions API takes a seed rather than a temperature;
# a fixed seed keeps runs as reproducible as the API allows.
REPO_ARCHAEOLOGIST_SEED=7

# Gemini thinking level: "low" | "medium" | "high". Higher costs more output tokens.
REPO_ARCHAEOLOGIST_THINKING_LEVEL=low

# Output token ceiling. Raise it if analyses come back truncated.
REPO_ARCHAEOLOGIST_MAX_OUTPUT_TOKENS=24000

# ---------------------------------------------------------------------------
# Exploration budget (advanced system only).
#
# Every value is a hard ceiling, enforced in code rather than requested in the
# prompt. They exist so a run has a known worst case: a bounded number of model
# calls, and a bounded amount of repository text in the context. Raising them
# buys deeper exploration at the cost of tokens, latency and rate-limit risk.
# Each must be a positive whole number; the values below are the defaults.
# ---------------------------------------------------------------------------

# Total tool calls allowed across one run.
REPO_ARCHAEOLOGIST_MAX_TOOL_CALLS=12

# Model turns allowed before synthesis is forced, whatever the model wanted next.
REPO_ARCHAEOLOGIST_MAX_TURNS=8

# Rows returned by one search_code call.
REPO_ARCHAEOLOGIST_MAX_SEARCH_RESULTS=20

# Lines and bytes returned by one read_file call, whichever limit binds first.
REPO_ARCHAEOLOGIST_MAX_FILE_LINES=400
REPO_ARCHAEOLOGIST_MAX_FILE_BYTES=24000

# Entries and depth for one list_directory call.
REPO_ARCHAEOLOGIST_MAX_LIST_ENTRIES=200
REPO_ARCHAEOLOGIST_MAX_LIST_DEPTH=3

# Scout budget: the pre-exploration pass that picks search terms and files before
# the model's first turn. Bounded for the same reason as the rest — a known worst case.
REPO_ARCHAEOLOGIST_MAX_SCOUT_TERMS=14
REPO_ARCHAEOLOGIST_MAX_SCOUT_SEARCHES=14
REPO_ARCHAEOLOGIST_MAX_SCOUT_FILES=4

# ---------------------------------------------------------------------------
# Evidence precision (advanced system only).
#
# How many extra citations a claim may carry, and how much text each contributes.
# MAX_CORROBORATIONS may be 0, which turns corroboration off.
# ---------------------------------------------------------------------------
REPO_ARCHAEOLOGIST_MAX_CORROBORATIONS=2
REPO_ARCHAEOLOGIST_MIN_CORROBORATION_TERMS=2
REPO_ARCHAEOLOGIST_MAX_CORROBORATION_CHARS=240

# ---------------------------------------------------------------------------
# Run identity and storage.
# ---------------------------------------------------------------------------

# Where this run came from, so a number is still interpretable in six weeks.
# Lowercase slug: letters, digits, dot, dash, underscore, slash; 64 chars max.
# `--provenance` overrides this. Unset means the run is stored as "unlabelled",
# which is honest rather than flattering. Never put a path or a secret here — the
# label is persisted, printed in reports and returned over HTTP.
REPO_ARCHAEOLOGIST_PROVENANCE=

# Where the web server keeps its analysis database. `--db` overrides this.
# Unset means ~/.repo-archaeologist/analyses.db. ":memory:" keeps nothing.
# A path inside the analysed workspace is refused: the analysis could read it, and
# `git clean` could delete it.
REPO_ARCHAEOLOGIST_DB=

# Host and port have no environment variable. They are flags, because a server
# that moves its own socket based on ambient environment is a server nobody can
# find: `pnpm web -- --host 127.0.0.1 --port 4173` (the defaults).
