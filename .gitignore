node_modules/
.pnpm-store/

# Secrets. Only .env.example is tracked.
.env
.env.local
.env.*.local

# Generated evaluation fixtures. Rebuild with `pnpm fixtures:build`.
# They contain their own .git directories and must not be nested inside this repo's history.
fixtures/*/

# Run output. Regenerated by `pnpm repo:baseline` and `pnpm evaluate:baseline`.
# Deliberately untracked: a committed mock-provider report is easily mistaken for a
# measured result. The directories themselves are kept via .gitkeep.
reports/*
trajectories/*
evaluation/results/*
!reports/.gitkeep
!trajectories/.gitkeep
!evaluation/results/.gitkeep

# Runtime databases. The web server's analysis store defaults to
# ~/.repo-archaeologist/analyses.db and `resolveDatabaseLocation` refuses a database
# inside the workspace, so the default case cannot land one here — but `--db ./local.db`
# is accepted, and WAL and shared-memory sidecars would appear beside it.
*.db
*.db-journal
*.sqlite
*.sqlite3
*-wal
*-shm

# Build / tooling artefacts
*.tsbuildinfo
coverage/
*.log
*.pid
.DS_Store
.idea/
.vscode/
*.swp
